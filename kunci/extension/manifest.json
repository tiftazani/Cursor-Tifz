{
  "manifest_version": 3,
  "name": "Kunci Autofill",
  "version": "1.2.2",
  "description": "Isi login website (bukan field lain), dengan ikon Kunci di luar kotak, dari brankas Kunci.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kunci",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["ext-api.js", "login-intent.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Isi login dengan Kunci"
    }
  }
}
