# Cloudflare Worker (production). Jangan commit nilai asli. Set via: npx wrangler secret put <NAMA>

# Wajib: string acak min. 16 karakter. Contoh: openssl rand -base64 32
KUNCI_SESSION_SECRET=

# Wajib untuk OTP gerbang publik (https://resend.com)
RESEND_API_KEY=

# Opsional. Default: Kunci <onboarding@resend.dev>
# KUNCI_FROM_EMAIL=Kunci <noreply@domainmu>
