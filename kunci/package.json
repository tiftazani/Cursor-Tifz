{
  "name": "kunci",
  "private": true,
  "version": "1.0.0",
  "description": "Manajer kata sandi zero-knowledge untuk Mac",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-icons.mjs && tsc -b && vite build",
    "lint": "oxlint src tests worker",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "helper": "node helper/daemon.mjs",
    "mac": "node helper/mac-fill.mjs --with-ui",
    "start": "node helper/daemon.mjs --serve-ui",
    "local": "node scripts/run-local.mjs",
    "install-service": "node helper/install-service.mjs",
    "uninstall-service": "node helper/install-service.mjs --uninstall",
    "install-safari": "node helper/install-safari-extension.mjs",
    "ambil-branch": "bash scripts/ambil-branch.sh",
    "sync-branch": "node scripts/sync-branch.mjs",
    "refresh-local": "node scripts/sync-branch.mjs && node helper/install-service.mjs",
    "extension-status": "node scripts/extension-status.mjs",
    "set-resend-key": "node scripts/set-resend-key.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:secrets": "wrangler secret put KUNCI_SESSION_SECRET && wrangler secret put RESEND_API_KEY"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.2",
    "wrangler": "^4.137.0"
  }
}
