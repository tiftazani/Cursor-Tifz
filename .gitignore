# Hub repo — app lives in subfolders
node_modules/
.next/
out/
build/
.vercel
.netlify
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts
.env*
!.env.example
npm-debug.log*
.pnpm-debug.log*
.gradle/
**/.kotlin/
**/.wrangler/
**/local.properties
**/*.jks
**/*.keystore
**/google-services.json

# Release signing credentials must remain outside version control
**/cuciin-signing.properties
**/signing-private/
laundry-ops/cloudflare/backups/

# Aset referensi desain lokal (gambar lampiran besar, bukan bagian aplikasi)
laundry-ops/Image/
laundry-ops/Design airbnb.md
laundry-ops/LAUNDRY_APP_UI_UX_GUIDELINE.md

# Artefak APK/AAB kandidat tidak ikut Git karena ukurannya besar (puluhan MB per kandidat).
# Yang disimpan hanya README, SHA256SUMS, dan template Excel. Bila Owner minta satu kandidat
# tertentu ikut Git, tambahkan dengan git add -f.
laundry-ops/releases/*-candidate/*.apk
laundry-ops/releases/*-candidate/*.aab

# Hasil bangunan dokumen (HTML+PDF). Sumbernya Markdown di docs/, hasilnya dibuat
# ulang dengan: python3 tools/bangun_dokumen.py && python3 tools/gabung_dokumen.py
laundry-ops/docs/_terbangun/
laundry-ops/tools/__pycache__/
# Skrip Cloudflare memakai Python; jalankan `py_compile` atau impor apa pun
# meninggalkan berkas .pyc yang tidak boleh ikut masuk repositori.
__pycache__/
*.pyc
